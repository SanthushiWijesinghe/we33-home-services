# Supabase project URL and publishable key are safe for a client build.
# Keep all secret keys and database passwords out of VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional Express API URL for future complex workflows.
# Browser: http://localhost:3000/api
# Android emulator: http://10.0.2.2:3000/api
# Physical phone: http://YOUR_COMPUTER_LAN_IP:3000/api
VITE_API_URL=
